(version 1)

# VBUS (net class Power) must be wide enough for USB current (500 mA+ with ESP32 RF peaks).
# Net class widths are only defaults for the router; this rule makes DRC enforce it.
(rule "power_track_width"
	(condition "A.hasNetclass('Power') && A.Type == 'Track'")
	(constraint track_width (min 0.4mm))
	(severity error))

# JLCPCB 2-layer standard capabilities (with margin)
(rule "jlc_hole_to_hole"
	(constraint hole_to_hole (min 0.5mm)))
(rule "jlc_edge_clearance"
	(constraint edge_clearance (min 0.3mm)))

# Tiny SMD pads (USB-C contacts, 0.5 mm-pitch LGA) can only get one thermal spoke
# from a pour; accept that for these two parts only.
(rule "fine_pitch_single_spoke"
	(condition "A.Type == 'Pad' && (A.memberOfFootprint('J1') || A.memberOfFootprint('U3'))")
	(constraint min_resolved_spokes (min 1)))
